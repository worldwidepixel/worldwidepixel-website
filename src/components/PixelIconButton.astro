---
const { text, to, external } = Astro.props;
---

<a
	target={external === true ? "_blank" : ""}
	href={to}
	class="bg-brand-background-blue text-brand-text-secondary hover:border-brand-border-alt focus-visible:border-brand-border-alt button-shadow-dova flex flex-row items-center gap-4 border-8 p-4 text-2xl font-bold outline-hidden select-none">
	{text}
	<slot />
</a>

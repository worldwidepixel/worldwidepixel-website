---
import { ExternalLink } from "@lucide/astro";

const { external, showIcon, to, classList, style } = Astro.props;
---

<a
	href={to}
	target={external ? "_blank" : ""}
	style={style ?? ""}
	class={"px-3 py-2 text-lg button button-shadow-dova bg-brand-background-secondary" + (classList ?? "")}>
	{
		external && (
			<span class="text-brand-text-secondary flex w-fit flex-row items-center gap-2 font-bold">
				<slot /> {showIcon && <ExternalLink />}
			</span>
		)
	}
	{
		!external && (
			<span class="text-brand-text-secondary font-bold">
				<slot />
			</span>
		)
	}
</a>
